#: templates/admin/catalog/margin_report.html:270
#: templates/admin/catalog/price_sheet.html:154
#: templates/admin/catalog/price_sheet.html:213
msgid "Price"
msgstr "Цена"

#: catalog/admin.py:1209 templates/admin/catalog/price_sheet.html:155
#: templates/admin/catalog/price_sheet.html:214
msgid "Margin"
msgstr "Маржа"

#: catalog/admin.py:1224
msgid "Calculated margin"
msgstr "Расчётная маржа"

#: catalog/admin.py:1243
msgid "Recalculate prices from cost and rules"
msgstr "Пересчитать цены по себестоимости и правилам"

#: catalog/admin.py:1280 catalog/admin.py:1415
#: templates/admin/catalog/ai_pricing.html:178
msgid "Applies to"
msgstr "Применяется к"

#: catalog/admin.py:1284
msgid ""
"The narrowest rule about a tariff wins. In order: this destination AND this "
"size, then this size everywhere, then this destination, then this supplier, "
"then the house default. Leave the size empty unless the rule is about one."
msgstr ""
"Побеждает самое узкое правило о тарифе. Порядок: это направление И этот "
"размер, затем этот размер везде, затем это направление, затем этот "
"поставщик, и в конце — правило по умолчанию. Если правило не про один "
"размер, оставьте размер пустым."

#: catalog/admin.py:1291 catalog/admin.py:1419
#: templates/admin/catalog/ai_pricing.html:179
