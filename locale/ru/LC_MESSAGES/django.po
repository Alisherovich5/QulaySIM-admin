#, python-brace-format
msgid "“{other}” already holds position {position}. The site breaks the tie by name; give one of them its own number."
msgstr "«{other}» уже занимает позицию {position}. При совпадении сайт сортирует по названию; дайте одному из них собственный номер."

msgid "Promote to the landing page"
msgstr "Показывать на главной"

#, python-brace-format
msgid "{count} destination(s) added to the landing page."
msgstr "{count} направлений добавлено на главную."

