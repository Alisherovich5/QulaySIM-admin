#: templates/admin/catalog/margin_report.html:271
#: templates/admin/catalog/margin_report.html:309
msgid "Markup"
msgstr "Наценка"

#: catalog/admin.py:1296
msgid "What this does"
msgstr "Что это делает"

#: catalog/admin.py:1297
msgid "Admin"
msgstr "Админ"

#: catalog/admin.py:1337
msgid "You do not have permission to change pricing rules."
msgstr "У вас нет прав изменять правила ценообразования."

#: catalog/admin.py:1351
msgid "The proposal could not be read. Ask again."
msgstr "Предложение не удалось прочитать. Спросите заново."

#: catalog/admin.py:1359
#, python-format
msgid "%(count)s rule(s) saved. Prices have been recalculated."
msgstr "Сохранено правил: %(count)s. Цены пересчитаны."

#: catalog/admin.py:1363
msgid "Nothing was saved — no usable rule remained."
msgstr "Ничего не сохранено — не осталось ни одного пригодного правила."

#: catalog/admin.py:1373
msgid "The assistant's answer could not be read."
msgstr "Ответ ассистента не удалось прочитать."

#: catalog/admin.py:1386 config/settings.py:486
#: templates/admin/catalog/margin_report.html:91
msgid "Pricing assistant"
msgstr "Ассистент цен"

#: catalog/admin.py:1395
msgid "Every 1 GB tariff earns 200%."
msgstr "Каждый тариф на 1 ГБ приносит 200%."

#: catalog/admin.py:1396
msgid "Turkey and Georgia at 60%, everything else stays."
msgstr "Турция и Грузия по 60%, остальное без изменений."

#: catalog/admin.py:1397
msgid "Nothing may earn less than half a dollar."
msgstr "Ничто не должно приносить меньше половины доллара."

#: catalog/admin.py:1398
msgid "Prices should end in .99."
msgstr "Цены должны заканчиваться на .99."

#: catalog/admin.py:1403
msgid "Traffic size"
msgstr "Размер трафика"

#: catalog/admin.py:1412
msgid "any size"
msgstr "любой размер"

#: catalog/admin.py:1425
msgid "In plain words"
msgstr "Простыми словами"

#: catalog/admin.py:1434
msgid "Save the rule to see a summary."
msgstr "Сохраните правило, чтобы увидеть описание."

#: catalog/admin.py:1440
msgid "every plan that no more specific rule covers"
msgstr "каждого тарифа, который не покрыт более конкретным правилом"

#: catalog/admin.py:1441
#, python-format
msgid "every plan sourced from %(p)s"
msgstr "каждого тарифа от %(p)s"

#: catalog/admin.py:1443
#, python-format
msgid "every plan for %(c)s"
msgstr "каждого тарифа для %(c)s"

#: catalog/admin.py:1445
#, python-format
msgid "every %(t)s plan, in every destination"
msgstr "тариф %(t)s в каждом направлении"

#: catalog/admin.py:1447
msgid "the plans this rule covers"
msgstr "тарифы, охваченные этим правилом"

#: catalog/admin.py:1451
#, python-format
msgid "the %(t)s plan for %(c)s"
msgstr "тариф %(t)s для %(c)s"

#: catalog/admin.py:1457
#, python-format
msgid "On %(who)s, the selling price is the supplier cost plus %(pct)s%%."
msgstr "Для %(who)s цена продажи — себестоимость плюс %(pct)s%%."

#: catalog/admin.py:1462
#, python-format
msgid ""
"If that leaves less than $%(m)s of profit, the price rises until it does."
msgstr "Если прибыль окажется меньше $%(m)s, цена поднимается до этого уровня."

#: catalog/admin.py:1467
msgid "The result is then rounded up to end in .99."
msgstr "Затем результат округляется вверх до окончания на .99."

#: catalog/admin.py:1468
msgid "The result is then rounded up to the next 50 cents."
msgstr "Затем результат округляется вверх до следующих 50 центов."

#: catalog/admin.py:1469
msgid "The result is then rounded up to a whole dollar."
msgstr "Затем результат округляется вверх до целого доллара."

#: catalog/admin.py:1474
msgid "This rule is switched off, so it changes nothing right now."
msgstr "Правило отключено, поэтому сейчас ничего не меняет."

#: catalog/admin.py:1480
msgid "Which plans this rule decides"
msgstr "Какими тарифами управляет это правило"

#: catalog/admin.py:1492
msgid "Save the rule to see its reach."
msgstr "Сохраните правило, чтобы увидеть охват."

#: catalog/admin.py:1537 catalog/admin.py:1601
msgid "No priced plans fall under this rule yet."
msgstr "Под это правило пока не попадает ни один тариф с ценой."

#: catalog/admin.py:1540
#, python-format
msgid "This rule sets the price of %(d)s of the %(c)s plans in its scope."
msgstr "Это правило задаёт цену для %(d)s из %(c)s тарифов в своём охвате."

#: catalog/admin.py:1545
#, python-format
msgid "%(n)s are governed by a more specific rule."
msgstr "%(n)s управляются более конкретным правилом."

#: catalog/admin.py:1548
#, python-format
msgid "%(n)s carry their own markup, which overrides any rule."
msgstr "У %(n)s своя наценка — она перекрывает любое правило."

#: catalog/admin.py:1551
#, python-format
msgid "%(n)s have a locked price and are never recalculated."
msgstr "У %(n)s цена закреплена и не пересчитывается."

#: catalog/admin.py:1558
msgid "What prices would become"
msgstr "Какими станут цены"

#: catalog/admin.py:1568
msgid "Save the rule to preview prices."
msgstr "Сохраните правило, чтобы увидеть цены."

#: catalog/admin.py:1634
msgid "Price now → after"
msgstr "Цена сейчас → после"

#: catalog/admin.py:1635 templates/admin/catalog/ai_pricing.html:232
#: templates/admin/catalog/margin_report.html:206
#: templates/admin/catalog/margin_report.html:308 templates/admin/index.html:96
#: templates/admin/index.html:156
msgid "Profit"
msgstr "Прибыль"

#: catalog/admin.py:1637
msgid ""
"A sample of the plans this rule governs. Saving applies it to all of them."
msgstr ""
"Выборка тарифов, которыми управляет это правило. При сохранении применится "
"ко всем."

#: catalog/admin.py:1708
msgid "Plans covered"
msgstr "Охваченные тарифы"

#: catalog/admin.py:1721
msgid "Recalculate every affected plan now"
msgstr "Пересчитать все затронутые тарифы сейчас"

#: catalog/admin.py:1835
msgid "Verdict"
msgstr "Вывод"

#: catalog/admin.py:1854
msgid "cheapest"
msgstr "самый дешёвый"

#: catalog/admin.py:1857
#, python-brace-format
msgid "saves ${amount}"
msgstr "экономит ${amount}"

#: catalog/admin.py:1863
#, python-brace-format
msgid "+${amount} vs {provider}"
msgstr "+${amount} к {provider}"

#: catalog/admin.py:1869
msgid "Mark available (put back in the running)"
msgstr "Отметить доступным (вернуть в отбор)"

#: catalog/admin.py:1881
msgid "Mark unavailable (take out of the running)"
msgstr "Отметить недоступным (убрать из отбора)"

#: catalog/admin.py:1928 templates/admin/catalog/import_prices.html:134
msgid "Result"
msgstr "Итог"

#: catalog/admin.py:1938 templates/admin/catalog/import_prices.html:155
msgid "Preview"
msgstr "Предпросмотр выполнен"

#: catalog/admin.py:1947
msgid "Took"
msgstr "Длительность"

#: catalog/ai_pricing.py:92 catalog/models.py:499
msgid "Everything (house default)"
msgstr "Всё (правило по умолчанию)"

#: catalog/ai_pricing.py:98
msgid "every destination"
msgstr "каждое направление"

#: catalog/ai_pricing.py:343
msgid "The anthropic package is not installed on the server."
msgstr "Пакет anthropic не установлен на сервере."

#: catalog/ai_pricing.py:350
msgid ""
"ANTHROPIC_API_KEY is not set on the server, so the assistant cannot be "
"reached. Everything else on this page works without it."
msgstr ""
"На сервере не задан ANTHROPIC_API_KEY, поэтому ассистент недоступен. Всё "
"остальное на этой странице работает и без него."

#: catalog/ai_pricing.py:438
msgid "The assistant declined to answer this instruction. Rephrase it."
msgstr "Ассистент отказался отвечать на эту инструкцию. Переформулируйте её."

#: catalog/ai_pricing.py:443
msgid "The assistant returned an empty answer."
msgstr "Ассистент вернул пустой ответ."

#: catalog/ai_pricing.py:497
msgid "Unknown rule type."
msgstr "Неизвестный тип правила."

#: catalog/ai_pricing.py:499
#, python-format
msgid "Markup %(value)s%% is outside the allowed 0–%(max)s%%."
msgstr "Наценка %(value)s%% вне допустимого диапазона 0–%(max)s%%."

#: catalog/ai_pricing.py:504
msgid "Profit floor is outside the allowed range."
msgstr "Порог прибыли вне допустимого диапазона."

#: catalog/ai_pricing.py:506
msgid "Unknown rounding mode."
msgstr "Неизвестный режим округления."

#: catalog/ai_pricing.py:510
#, python-format
msgid "There is no destination %(code)s in the catalogue."
msgstr "В каталоге нет направления %(code)s."

#: catalog/ai_pricing.py:518
#, python-format
msgid "There is no supplier %(name)s in the catalogue."
msgstr "В каталоге нет поставщика %(name)s."

#: catalog/ai_pricing.py:522
msgid "A size rule has to name a size."
msgstr "Правило по объёму обязано указывать объём."

#: catalog/ai_pricing.py:527
#, python-format
msgid "No tariff has a size of %(mb)s MB."
msgstr "Ни у одного тарифа нет объёма %(mb)s МБ."

#: catalog/ai_pricing.py:822
msgid "The assistant declined to write the commentary."
msgstr "Ассистент отказался писать комментарий."

#: catalog/apps.py:8 config/settings.py:449
msgid "Catalog"
msgstr "Каталог"

#: catalog/forms.py:16
msgid "Wholesaler"
msgstr "Оптовый поставщик"

#: catalog/forms.py:17
msgid "Which supplier's price list this file is."
msgstr "Прайс какого поставщика содержится в файле."

#: catalog/forms.py:20
msgid "Price list (CSV)"
msgstr "Прайс-лист (CSV)"

#: catalog/forms.py:22
msgid ""
"Needs the columns package_code, location, data_gb, days, cost_usd. The "
"export from the supplier's portal already has them."
msgstr ""
"Нужны столбцы package_code, location, data_gb, days, cost_usd. В выгрузке из "
"портала поставщика они уже есть."

#: catalog/forms.py:29
msgid "Preview only — do not write anything"
msgstr "Только предпросмотр — ничего не записывать"

#: catalog/forms.py:31
msgid ""
"Leave this on the first time. Applying moves supplier costs, which moves "
"retail prices through the pricing rules."
msgstr ""
"В первый раз оставьте включённым. Применение меняет себестоимость, а через "
"правила ценообразования — и розничные цены."

#: catalog/forms.py:43
msgid "Limit to these destinations"
msgstr "Ограничить этими направлениями"

#: catalog/forms.py:46
msgid ""
"ISO codes, comma-separated. Leave empty to apply the whole file — naming "
"destinations is how you set one up without repricing the rest."
