#: catalog/admin.py:556
#, python-brace-format
msgid ""
"No supplier offers yet, so the cost above is used as typed and orders route "
"to <b>{}</b>. Add two offers below to have the cheaper one chosen "
"automatically."
msgstr ""
"Hozircha ta’minotchi taklifi yo‘q, shuning uchun yuqoridagi tannarx qanday "
"yozilgan bo‘lsa shundayligicha ishlatiladi va buyurtmalar <b>{}</b> ga "
"yo‘naltiriladi. Arzonrog‘i avtomatik tanlanishi uchun pastda ikkita taklif "
"qo‘shing."

