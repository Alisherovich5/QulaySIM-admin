#: catalog/admin.py:1095
msgid "vs"
msgstr "vs"

#: catalog/admin.py:1114
msgid "no connected supplier"
msgstr "ulangan ta’minotchi yo‘q"

#: catalog/admin.py:1117
msgid "Supplier comparison"
msgstr "Ta’minotchilarni solishtirish"

#: catalog/admin.py:1120
msgid "Save the plan, then add supplier prices below to compare them."
msgstr ""
"Tarifni saqlang, so‘ng solishtirish uchun pastda ta’minotchi narxlarini "
"qo‘shing."

#: catalog/admin.py:1126
#, python-brace-format
msgid ""
"No supplier offers yet, so the cost above is used as typed and orders route "
"to <b>{}</b>. Add two offers below to have the cheaper one chosen "
"automatically."
msgstr ""
"Hozircha ta’minotchi taklifi yo‘q, shuning uchun yuqoridagi tannarx qanday "
"yozilgan bo‘lsa shundayligicha ishlatiladi va buyurtmalar <b>{}</b> ga "
"yo‘naltiriladi. Arzonrog‘i avtomatik tanlanishi uchun pastda ikkita taklif "
"qo‘shing."

#: catalog/admin.py:1140 catalog/admin.py:1841
msgid "unavailable"
msgstr "mavjud emas"

#: catalog/admin.py:1167
