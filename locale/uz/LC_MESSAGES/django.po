msgstr "O'lcham qoidasi o'lchamni ko'rsatishi shart."

#: catalog/ai_pricing.py:527
#, python-format
msgid "No tariff has a size of %(mb)s MB."
msgstr "Hech bir tarifning o'lchami %(mb)s MB emas."

