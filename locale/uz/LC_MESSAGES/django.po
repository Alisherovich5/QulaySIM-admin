#: templates/admin/catalog/ai_pricing.html:174
msgid ""
"The narrowest rule about a tariff wins. Saving one replaces any existing "
"rule with the same target."
msgstr ""
"Tarif haqidagi eng tor qoida g'olib. Bittasini saqlash o'sha nishonga "
"tegishli mavjud qoidani almashtiradi."

